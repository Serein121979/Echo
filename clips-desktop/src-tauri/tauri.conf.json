{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Desktop",
  "version": "0.3.0",
  "identifier": "com.zhuanz.echo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Echo Desktop",
        "width": 460,
        "height": 720,
        "minWidth": 56,
        "minHeight": 56,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://*.supabase.co",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
