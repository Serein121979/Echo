{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Clips Desktop",
  "version": "0.1.0",
  "identifier": "com.zhuanz.echo-clips",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echo Clips Desktop",
        "width": 420,
        "height": 760,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
